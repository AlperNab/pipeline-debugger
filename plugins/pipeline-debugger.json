  "core_job": "Pipeline logs/config → failure diagnosis",
  "deep_features": [
    "failing step detection",
    "config diff",
    "dependency/cache issue classifier",
    "retry safety",
    "patch recommendation",
    "CI provider integration",
    "incident link"
  ],
  "input_schema": [
    {
      "key": "pipeline_logs",
